(
    version: 1,
    name: "Earth-like refined",
    seed: 1,
    radius: 6371000.0,
    sea_level: 0.0,
    layers: [
        // A few very broad shapes establish continents. Angular noise keeps
        // their apparent size independent of the planet radius.
        (
            id: 1,
            name: "Continental shapes",
            enabled: true,
            target: Continents,
            operation: Replace,
            source: Noise((
                kind: Fbm,
                domain: Angular,
                scale: 2.2,
                amplitude: 1.0,
                bias: 0.0,
                octaves: 6,
                lacunarity: 2.03,
                persistence: 0.48,
                warp_scale: 0.75,
                warp_strength: 0.14,
                seed_offset: 10,
            )),
            mask: None,
        ),
        (
            id: 2,
            name: "Land mask",
            enabled: true,
            target: Land,
            operation: Replace,
            source: Channel(
                channel: Continents,
                input_min: -0.2,
                input_max: 0.32,
                output_min: 0.0,
                output_max: 1.0,
                smooth: true,
            ),
            mask: None,
        ),
        // Unit-amplitude ridged noise is important here: the following masks
        // and channel remaps are authored for a 0..1 mountain signal.
        (
            id: 3,
            name: "Mountain belts",
            enabled: true,
            target: Mountains,
            operation: Replace,
            source: Noise((
                kind: Ridged,
                domain: Angular,
                scale: 28.0,
                amplitude: 1.0,
                bias: 0.0,
                octaves: 5,
                lacunarity: 2.03,
                persistence: 0.48,
                warp_scale: 0.8,
                warp_strength: 0.16,
                seed_offset: 70,
            )),
            mask: Some((
                channel: Land,
                minimum: 0.15,
                maximum: 0.8,
                smooth: true,
                invert: false,
            )),
        ),
        (
            id: 4,
            name: "Plains",
            enabled: true,
            target: Plains,
            operation: Replace,
            source: Channel(
                channel: Mountains,
                input_min: 0.2,
                input_max: 0.75,
                output_min: 1.0,
                output_max: 0.0,
                smooth: true,
            ),
            mask: Some((
                channel: Land,
                minimum: 0.1,
                maximum: 0.8,
                smooth: true,
                invert: false,
            )),
        ),
        (
            id: 5,
            name: "Continental elevation",
            enabled: true,
            target: Height,
            operation: Replace,
            source: Channel(
                channel: Land,
                input_min: 0.0,
                input_max: 1.0,
                output_min: -4200.0,
                output_max: 700.0,
                smooth: true,
            ),
            mask: None,
        ),
        (
            id: 6,
            name: "Mountain elevation",
            enabled: true,
            target: Height,
            operation: Add,
            source: Channel(
                channel: Mountains,
                input_min: 0.22,
                input_max: 0.82,
                output_min: 0.0,
                output_max: 6800.0,
                smooth: true,
            ),
            mask: Some((
                channel: Land,
                minimum: 0.22,
                maximum: 0.82,
                smooth: true,
                invert: false,
            )),
        ),
        // Kilometre-scale noise breaks the broad belts into clearly visible
        // ridges and valleys instead of one long, nearly flat slope.
        (
            id: 7,
            name: "Regional mountain relief",
            enabled: true,
            target: Height,
            operation: Add,
            source: Noise((
                kind: Ridged,
                domain: SurfaceMeters,
                scale: 8000.0,
                amplitude: 1000.0,
                bias: 0.0,
                octaves: 5,
                lacunarity: 2.03,
                persistence: 0.5,
                warp_scale: 0.8,
                warp_strength: 0.18,
                seed_offset: 50,
            )),
            mask: Some((
                channel: Mountains,
                minimum: 0.18,
                maximum: 0.68,
                smooth: true,
                invert: false,
            )),
        ),
        // Sub-kilometre variation makes the terrain visibly uneven nearby.
        (
            id: 8,
            name: "Local ground relief",
            enabled: true,
            target: Height,
            operation: Add,
            source: Noise((
                kind: Fbm,
                domain: SurfaceMeters,
                scale: 500.0,
                amplitude: 120.0,
                bias: 0.0,
                octaves: 4,
                lacunarity: 2.03,
                persistence: 0.48,
                warp_scale: 0.7,
                warp_strength: 0.12,
                seed_offset: 60,
            )),
            mask: Some((
                channel: Land,
                minimum: 0.15,
                maximum: 0.82,
                smooth: true,
                invert: false,
            )),
        ),
        // This channel is normalized because it is consumed like a mask.
        // Its scale describes regional drainage rather than individual rocks.
        (
            id: 9,
            name: "River potential",
            enabled: true,
            target: Rivers,
            operation: Replace,
            source: Noise((
                kind: Ridged,
                domain: SurfaceMeters,
                scale: 6000.0,
                amplitude: 1.0,
                bias: 0.0,
                octaves: 4,
                lacunarity: 2.03,
                persistence: 0.5,
                warp_scale: 0.65,
                warp_strength: 0.3,
                seed_offset: 70,
            )),
            mask: Some((
                channel: Land,
                minimum: 0.28,
                maximum: 0.88,
                smooth: true,
                invert: false,
            )),
        ),
        // Turn the river-potential channel into shallow visible drainage. This
        // layer introduces no new random seed; it reuses layer 9's result.
        (
            id: 10,
            name: "River valleys",
            enabled: true,
            target: Height,
            operation: Add,
            source: Channel(
                channel: Rivers,
                input_min: 0.62,
                input_max: 0.9,
                output_min: 0.0,
                output_max: -180.0,
                smooth: true,
            ),
            mask: Some((
                channel: Land,
                minimum: 0.35,
                maximum: 0.9,
                smooth: true,
                invert: false,
            )),
        ),
    ],
)
