{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Editor (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/editor-runner.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "RUST_BACKTRACE",
                    "value": "1"
                }
            ],
            "stopAtEntry": false,
            "preLaunchTask": "cargo build"
        },
        {
            "name": "Debug Game (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/game-runner.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "preLaunchTask": "cargo build"
        }
    ]
}